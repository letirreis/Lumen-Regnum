# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# Só use a chave PÚBLICA (anon / publishable). A chave service_role jamais deve entrar no front-end.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- Só no servidor (Vercel > Settings > Environment Variables). NUNCA com prefixo VITE_ ---
# Chave restrita do Stripe (Developers > API keys > Create restricted key), com permissão de escrita em:
# Checkout Sessions, Customer portal, e leitura em Prices e Subscriptions.
STRIPE_SECRET_KEY=rk_live_...
# Segredo do webhook (aparece ao criar o endpoint https://SEU-SITE/api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# Chave service_role do Supabase (Project Settings > API). Dá acesso total ao banco: jamais no front-end.
SUPABASE_SERVICE_ROLE_KEY=...
# Endereço público do site, sem barra no final
SITE_URL=https://SEU-SITE.vercel.app
